<% if current_conversations(user).present? %>
  <ul class="divide-y divide-gray-200">
    <% current_conversations(user).each do |conversation| %>
      <li class="<%= 'bg-blue-50 hover:bg-gray-50' if @conversation == conversation %>">
        <%= link_to conversation_path(conversation),
                  class: "flex items-start p-2 rounded hover:bg-gray-100 gap-3",
                  data: { turbo_frame: "_top" } do %>

          <div class="flex-shrink-0">
            <%= image_tag Faker::Avatar.image(slug: "my-own-slug", size: "50x50"), class: 'rounded-full h-10 w-10' %>
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex justify-between items-baseline">
              <div class="font-medium truncate">
                <%= conversation.display_name(user) %>
              </div>
            </div>

            <% if conversation.messages.last %>
              <div class="text-sm text-gray-500 truncate">
                <%= conversation.messages.last.content.truncate(30) %>
              </div>
            <% end %>
          </div>

          <div class="flex flex-col items-end ml-2">

            <% if conversation.messages.last %>
              <div class="text-xs text-gray-500 whitespace-nowrap">
                <%=l conversation.messages.last.updated_at, format: :short %>
              </div>
            <% end %>
            <% if unread_count_for(conversation, user) > 0 %>
              <span class="mt-1 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                <%= unread_count_for(conversation, user) %>
              </span>
            <% end %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-gray-500 py-4">No conversations yet</p>
<% end %>
