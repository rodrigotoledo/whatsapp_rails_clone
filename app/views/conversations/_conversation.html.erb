<li class="hover:bg-gray-50">
  <%= link_to conversation_path(conversation), class: "block p-4" do %>
    <div class="flex justify-between items-start">
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium text-gray-900 truncate">
          <%= conversation.display_name(current_user) %>
        </p>

        <% if last_message = conversation.messages.last %>
          <p class="text-sm text-gray-500 truncate">
            <%= last_message.sender == current_user ? "Você: " : "" %>
            <%= last_message.content.truncate(50) %>
          </p>
        <% end %>
      </div>

      <div class="ml-4 flex-shrink-0 flex flex-col items-end">
        <% if conversation.updated_at > 24.hours.ago %>
          <time class="text-xs text-gray-500">
            <%= time_ago_in_words(conversation.updated_at) %> atrás
          </time>
        <% else %>
          <time class="text-xs text-gray-500">
            <%= conversation.updated_at.strftime("%d/%m/%Y") %>
          </time>
        <% end %>

        <% if unread_count_for(conversation, current_user) > 0 %>
          <span class="mt-1 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
            <%= unread_count_for(conversation, current_user) %>
          </span>
        <% end %>
      </div>
    </div>
  <% end %>
</li>
