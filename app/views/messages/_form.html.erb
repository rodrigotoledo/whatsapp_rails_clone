<%= turbo_frame_tag "new_message", target: "_top" do %>
  <%= form_with(model: [@conversation, Message.new],
               html: {
                 id: "message-form",
                 class: 'flex gap-2',
                 data: {
                   controller: "form",
                   action: "turbo:submit-end->form#reset"
                 }
               }) do |f| %>
    <%= f.text_field :content,
          placeholder: "Type your message...",
          required: true,
          class: 'border border-gray-200 p-1 flex-1 rounded shadow bg-white resize-none focus:outline-none',
          data: { "form-target": "input" } %>
    <%= f.submit "Send", class: "px-4 p-1 bg-green-900 text-white rounded" %>
  <% end %>
<% end %>
